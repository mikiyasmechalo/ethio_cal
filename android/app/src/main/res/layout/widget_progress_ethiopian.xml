<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#CC1E1E1E">

    <!-- Day -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/text_day"
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="none"
            android:typeface="monospace"
            android:text="ሰኞ"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/dots_day_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:typeface="monospace"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp"
                android:text="••••••••••"/>
            <TextView
                android:id="@+id/dots_day_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:typeface="monospace"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp"
                android:text="••••••••••"/>
        </LinearLayout>
        <TextView
            android:id="@+id/text_day_percent"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:typeface="monospace"
            android:text="72%"/>
    </LinearLayout>

    <!-- Week -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/text_week"
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="none"
            android:typeface="monospace"
            android:text="ሳምንት 1"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/dots_week_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:typeface="monospace"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp"
                android:text="•••••••···"/>
            <TextView
                android:id="@+id/dots_week_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:typeface="monospace"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp"
                android:text="•••••••···"/>
        </LinearLayout>
        <TextView
            android:id="@+id/text_week_percent"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:typeface="monospace"
            android:text="45%"/>
    </LinearLayout>

    <!-- Month -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/text_month"
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="none"
            android:typeface="monospace"
            android:text="ጥቅምት 17"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/dots_month_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:typeface="monospace"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp"
                android:text="••••••••··"/>
            <TextView
                android:id="@+id/dots_month_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:typeface="monospace"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp"
                android:text="••••••••··"/>
        </LinearLayout>
        <TextView
            android:id="@+id/text_month_percent"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:typeface="monospace"
            android:text="56%"/>
    </LinearLayout>

    <!-- Year -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/text_year"
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:singleLine="true"
            android:ellipsize="none"
            android:typeface="monospace"
            android:text="2017"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/dots_year_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:typeface="monospace"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp"
                android:text="•••·······"/>
            <TextView
                android:id="@+id/dots_year_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:includeFontPadding="false"
                android:typeface="monospace"
                android:textStyle="bold"
                android:lineSpacingExtra="-3dp"
                android:text="•••·······"/>
        </LinearLayout>
        <TextView
            android:id="@+id/text_year_percent"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:typeface="monospace"
            android:text="12%"/>
    </LinearLayout>
</LinearLayout>
